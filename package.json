{
  "name": "cah-qbank",
  "private": true,
  "bin": {
    "cah": "./tools/cli/dist/index.js",
    "generate": "./tools/generate/dist/index.js"
  },
  "scripts": {
    "postinstall": "pnpm --filter app prisma:generate && pnpm build:cli && pnpm build:generate",
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit",
    "test:unit": "pnpm -r test",
    "generation:test": "pnpm --filter @cah/generate test",
    "sync-db": "pnpm --filter app prisma:generate && pnpm --filter app prisma:bootstrap && pnpm --filter app exec tsx scripts/sync-db.ts",
    "migrate:backup": "pnpm exec tsx tools/migrate-from-backup.ts",
    "import:combined-unified": "pnpm exec tsx tools/import-combined-unified.ts",
    "tag:combined-import-curriculum": "pnpm exec tsx tools/tag-combined-import-curriculum.ts",
    "repair:combined-import-answerability": "pnpm exec tsx tools/repair-combined-import-answerability.ts",
    "prepare:combined-import-promotion": "pnpm exec tsx tools/prepare-combined-import-for-promotion.ts",
    "promote:combined-import": "pnpm exec tsx tools/promote-combined-import.ts",
    "analyze:cah-kat": "pnpm exec tsx tools/analyze-cah-kat-blueprint.ts",
    "validate:questions": "pnpm exec tsx tools/validate-questions.ts",
    "build:cli": "pnpm --filter @cah/cli build",
    "build:generate": "pnpm --filter @cah/generate build",
    "cah": "node tools/cli/dist/index.js",
    "generate": "node tools/generate/dist/index.js"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
