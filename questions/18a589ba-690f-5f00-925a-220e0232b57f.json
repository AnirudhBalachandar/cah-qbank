  "id": "18a589ba-690f-5f00-925a-220e0232b57f",
  "stem": "A premature neonate born at 30 weeks' gestation develops respiratory distress and grunting 3 hours after birth. What does the frontal chest X-ray show?",
  "questionType": "SBA",
  "options": [
    {
      "key": "A",
      "text": "Small lung fields with diffuse granularity and air bronchograms",
      "isCorrect": true
    },
    {
      "key": "B",
      "text": "Homogenous opacification of both normal volume lung fields",
      "isCorrect": false
    },
    {
      "key": "C",
      "text": "Normal appearance of a chest X-Ray in a neonate early in life",
      "isCorrect": false
    },
    {
      "key": "D",
      "text": "Non tension pneumothorax",
      "isCorrect": false
    },
    {
      "key": "E",
      "text": "Bilateral perihilar infiltrates",
      "isCorrect": false
    }
  ],
  "explanation": "The most likely diagnosis is neonatal respiratory distress syndrome (surfactant deficiency), which classically shows low lung volumes, diffuse reticulogranular/granular opacification, and air bronchograms on chest X-ray.",
